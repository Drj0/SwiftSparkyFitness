<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Reading step counts from Health. The app requests read access only;
	     it never writes to HealthKit, so com.apple.developer.healthkit.access
	     (clinical records) and any share types are deliberately absent. -->
	<key>com.apple.developer.healthkit</key>
	<true/>

	<!-- iCloud sync for local-only mode (Module 11). CloudKit only: the app
	     stores no documents and no key-value pairs, so CloudDocuments and
	     the ubiquity-store keys are deliberately absent.

	     SwiftData would pick the first container in this file on its own,
	     but LocalStore names this identifier explicitly — with one container
	     the two agree, and if a second is ever added the store won't silently
	     change which database it syncs to. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.drj.SwiftSparkyFitness</string>
	</array>

	<!-- CloudKit's silent pushes. Without this, another device's changes
	     only arrive when the app is next launched, so a mode switch made on
	     one device isn't seen live on the others. Xcode sets this to
	     "production" when archiving for distribution. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
